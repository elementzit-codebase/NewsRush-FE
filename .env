# Committed defaults for local development. Nothing secret belongs in this
# file — VITE_-prefixed values are inlined into the client bundle and shipped
# to the browser. For personal overrides use .env.local, which git ignores.

# Where the dev server proxies /api and /uploads. Read by vite.config.js at
# config time only, so it is never exposed to the browser.
API_PROXY_TARGET=http://127.0.0.1:8000

# Prefix the app puts in front of every API path at runtime. Empty means
# same-origin, which is what makes the dev proxy above work. Set this to an
# absolute URL for a build that talks to a backend on another host.
VITE_API_BASE=
